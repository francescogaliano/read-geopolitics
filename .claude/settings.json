{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/worker/kit/prepara.py\" || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 /tmp/rgdb.py *)"
    ]
  }
}
